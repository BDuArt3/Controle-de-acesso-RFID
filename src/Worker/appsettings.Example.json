{
  "//": "Copie este arquivo para appsettings.json na pasta do Worker e troque os valores entre colchetes. O arquivo real está no .gitignore.",
  "ApiSettings": {
    "BaseUrl": "http://localhost:5143"
  },
  "WorkerAuth": {
    "ApiKey": "[A_MESMA_CHAVE_CONFIGURADA_EM_WorkerAuth:ApiKey_NA_API]"
  },
  "SerialPortSettings": {
    "ComPortName": "COM4"
  },
  "AccessPoint": {
    "Location": "Portaria principal"
  },
  "Medicao": {
    "Habilitada": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}

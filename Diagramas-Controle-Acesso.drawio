        <mxCell id="salt-frame" value="alt  [Resultado da Validação de Acesso]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4a7c9d;strokeWidth=1.8;dashed=1;fontStyle=1;fontSize=15;fontColor=#1e293b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="410" y="525" width="750" height="205" as="geometry"/>
        </mxCell>


  <diagram id="atividades-validacao" name="Atividades - Validação">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Início -->
        <mxCell id="n-start" value="Início" style="ellipse;whiteSpace=wrap;html=1;fontSize=18;fontFamily=Helvetica;fontStyle=1;strokeColor=#4a7c9d;strokeWidth=2;fillColor=#ffffff;fontColor=#1e293b;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="175" y="40" width="70" height="70" as="geometry"/>
        </mxCell>

        <!-- 1. Aproximação -->
        <mxCell id="n-aprox" value="Usuário aproxima o cartão&#xa;do leitor RFID (MFRC522)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Helvetica;strokeColor=#4a7c9d;strokeWidth=1.8;fillColor=#ffffff;fontColor=#1e293b;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="300" height="75" as="geometry"/>
        </mxCell>

        <!-- 2. Leitura Serial -->
        <mxCell id="n-read" value="Arduino lê UID físico e GUID&#xa;do Bloco 4 e envia pela Serial" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Helvetica;strokeColor=#4a7c9d;strokeWidth=1.8;fillColor=#ffffff;fontColor=#1e293b;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="300" height="80" as="geometry"/>
        </mxCell>

        <!-- 3. Decisão: Recebeu dados? -->
        <mxCell id="d-complete" value="Worker recebeu&#xa;UID e GUID?" style="rhombus;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Helvetica;fontStyle=1;strokeColor=#4a7c9d;strokeWidth=2;fillColor=#ffffff;fontColor=#1e293b;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="110" y="430" width="200" height="130" as="geometry"/>
        </mxCell>

        <!-- 3.1 Aguardar -->
        <mxCell id="n-wait" value="Aguarda leitura&#xa;dos dois dados" style="rounded=0;whiteSpace=wrap;html=1;fontSize=16;fontFamily=Helvetica;strokeColor=#4a7c9d;strokeWidth=1.8;fillColor=#ffffff;fontColor=#1e293b;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="240" height="65" as="geometry"/>
        </mxCell>

        <!-- 4. Post HTTP -->
        <mxCell id="n-post" value="Worker envia POST&#xa;/api/acesso/verificar&#xa;(com cabeçalho X-Worker-Key)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Helvetica;strokeColor=#4a7c9d;strokeWidth=1.8;fillColor=#ffffff;fontColor=#1e293b;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="455" width="310" height="80" as="geometry"/>
        </mxCell>

        <!-- 5. Decisão: Chave válida? -->
        <mxCell id="d-auth" value="Chave do Worker&#xa;é válida?" style="rhombus;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Helvetica;fontStyle=1;strokeColor=#4a7c9d;strokeWidth=2;fillColor=#ffffff;fontColor=#1e293b;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="485" y="615" width="200" height="130" as="geometry"/>
        </mxCell>

        <!-- 6. Consulta DB -->
        <mxCell id="n-query" value="API busca Cartão por&#xa;Cartao.Uid&#xa;e carrega Titular associado" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Helvetica;strokeColor=#4a7c9d;strokeWidth=1.8;fillColor=#ffffff;fontColor=#1e293b;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="815" y="455" width="310" height="80" as="geometry"/>
        </mxCell>

        <!-- 7. Decisão: Regras -->
        <mxCell id="d-rules" value="Cartão Ativo, Titular Ativo&#xa;e Visitante não expirado&#xa;(&lt; 24h)?" style="rhombus;whiteSpace=wrap;html=1;fontSize=16;fontFamily=Helvetica;fontStyle=1;strokeColor=#4a7c9d;strokeWidth=2;fillColor=#ffffff;fontColor=#1e293b;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="845" y="605" width="250" height="150" as="geometry"/>
        </mxCell>

        <!-- RAMO SUPERIOR: PERMITIDO -->
        <mxCell id="n-log-ok" value="Persiste tentativa permitida&#xa;em LogsAcesso (AcessoAutorizado)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=17;fontFamily=Helvetica;strokeColor=#4a7c9d;strokeWidth=1.8;fillColor=#ffffff;fontColor=#1e293b;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="815" y="270" width="310" height="75" as="geometry"/>

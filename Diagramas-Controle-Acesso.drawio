        <mxCell id="sm1" value="1. Aproxima cartão do leitor" style="endArrow=block;html=1;fontSize=15;fontFamily=Helvetica;fontColor=#1e293b;strokeColor=#4a7c9d;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1">

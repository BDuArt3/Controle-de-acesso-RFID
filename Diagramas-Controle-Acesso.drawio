        <mxCell id="sm4" value="4. Retorna UID físico + GUID (16 hex)" style="endArrow=open;dashed=1;html=1;fontSize=15;fontFamily=Helvetica;fontColor=#1e293b;strokeColor=#4a7c9d;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="290" y="245" as="sourcePoint"/><mxPoint x="485" y="245" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- 5. Envio Serial -->
        <mxCell id="sm5" value="5. Serial: UID:{uid} e GUID:{guid}" style="endArrow=block;html=1;fontSize=15;fontFamily=Helvetica;fontColor=#1e293b;strokeColor=#4a7c9d;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="485" y="290" as="sourcePoint"/><mxPoint x="685" y="290" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- 6. POST HTTP -->
        <mxCell id="sm6" value="6. POST /api/acesso/verificar (X-Worker-Key, credencial)" style="endArrow=block;html=1;fontSize=15;fontFamily=Helvetica;fontColor=#1e293b;strokeColor=#4a7c9d;strokeWidth=1.6;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="685" y="340" as="sourcePoint"/><mxPoint x="890" y="340" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- 7. Consulta Banco -->
        <mxCell id="sm7" value="7. Consulta Cartão por Cartao.Uid e Titular associado" style="endArrow=block;html=1;fontSize=15;fontFamily=Helvetica;fontColor=#1e293b;strokeColor=#4a7c9d;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1">

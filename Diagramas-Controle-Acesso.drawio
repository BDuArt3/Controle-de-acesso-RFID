        <mxCell id="sm11" value="11. Serial: ACESSO:PERMITIDO (Acende LED Verde e libera catraca)" style="endArrow=block;html=1;fontSize=15;fontFamily=Helvetica;fontColor=#1e293b;strokeColor=#4a7c9d;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1">

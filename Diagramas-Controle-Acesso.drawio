        </mxCell>

        <!-- 8. Retorno do Banco -->
        <mxCell id="sm8" value="8. Retorna status do cartão, usuário e expiração" style="endArrow=open;dashed=1;html=1;fontSize=15;fontFamily=Helvetica;fontColor=#1e293b;strokeColor=#4a7c9d;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="435" as="sourcePoint"/><mxPoint x="890" y="435" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- 9. Regras e Auditoria -->
        <mxCell id="sm9" value="9. Valida regras de negócio e persiste LogsAcesso" style="endArrow=block;html=1;fontSize=15;fontFamily=Helvetica;fontColor=#1e293b;strokeColor=#4a7c9d;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="890" y="480" as="sourcePoint"/><mxPoint x="1100" y="480" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- ============================================================= -->
